# ── Groq (LLM generation + chat) ──
# Get a key at https://console.groq.com — the app degrades to heuristic
# chart generation without it, but chat and AI generation need it.
GROQ_API_KEY=
# Optional model overrides (both default to llama-3.3-70b-versatile):
# GROQ_DASHBOARD_MODEL=
# GROQ_CHAT_MODEL=

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed for account deletion and the BI-rules seed script:
SUPABASE_SERVICE_ROLE_KEY=
